$-- 只发 \bibliography{}，不发 \bibliographystyle{} —— 后者是 cls 的活。
$-- 参数是不带扩展名的基名（BibTeX 约定），writer 已把它改写成 references。
$if(bibliography)$
\bibliography{$for(bibliography)$$bibliography$$sep$,$endfor$}

$endif$
$for(include-after)$
$include-after$

$endfor$
